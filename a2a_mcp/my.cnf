# MariaDB tuned for what a2a actually is: a few thousand rows, a handful of
# concurrent streams, and one broker.
#
# 
# Two things are NOT tuned down, on purpose — see the durability block.

[mariadbd]
skip-name-resolve                       # no reverse DNS on connect
skip-log-bin                            # no replication; saves IO and disk

# --- InnoDB ---------------------------------------------------------------
# The whole dataset fits in 64M many times over. Raising this is the first
# thing to try if `docker stats` ever shows pressure.
innodb_buffer_pool_size       = 64M
innodb_log_file_size          = 32M
innodb_log_buffer_size        = 4M
innodb_flush_method           = O_DIRECT   # don't cache the same pages twice
innodb_read_io_threads        = 2          # default 4; fewer threads, less RAM
innodb_write_io_threads       = 2

# --- durability: deliberately expensive -----------------------------------
# This is the system of record, and the move off SQLite happened because data
# went missing silently. Trading either of these for CPU buys very little at
# this write volume and costs exactly the property the move was for.
innodb_flush_log_at_trx_commit = 1
innodb_doublewrite             = ON

# --- the two big non-obvious defaults -------------------------------------
# Aria backs internal temp tables and defaults to a 128M page cache; MyISAM is
# unused here and still reserves another 128M. Together they are the single
# largest saving in this file.
aria_pagecache_buffer_size    = 8M
key_buffer_size               = 8M

# --- connections ----------------------------------------------------------
# The broker's pool plus the occasional CLI, not the default 151. Each
# connection reserves its own buffers, which is why the per-connection numbers
# below matter more than they look.
max_connections               = 30
thread_cache_size             = 8
table_open_cache              = 128
# 400 is MariaDB's floor for this one — a smaller value is silently
# adjusted up, so anything lower just reads as intent that never applied.
table_definition_cache        = 400
sort_buffer_size              = 256K
read_buffer_size              = 128K
read_rnd_buffer_size          = 256K
join_buffer_size              = 256K
tmp_table_size                = 16M
max_heap_table_size           = 16M

# Off by default in MariaDB; pinned so it stays off if that ever changes. It
# is worth 100-250 MB on its own.
performance_schema            = OFF

# --- correctness ----------------------------------------------------------
# Agent ids are matched literally and delivery is a destructive read, so `Foo`
# and `foo` must stay two agents. Every table declares this collation itself;
# setting it server-wide means a table created by hand later cannot quietly
# get the case-insensitive default.
character-set-server          = utf8mb4
collation-server              = utf8mb4_bin
